{
  "name": "study-uet",
  "version": "1.0.0",
  "description": "Kho tài liệu và bài giảng ôn tập môn học UET",
  "type": "module",
  "scripts": {
    "audit:tokens": "node scripts/check-design-tokens.mjs",
    "audit:ui": "node scripts/audit-ui.mjs",
    "verify:redesign": "node scripts/verify-redesign.mjs",
    "sync:courses": "node scripts/sync-courses.mjs",
    "ci:build": "node scripts/build/build-site.mjs",
    "dev": "vitepress dev docs",
    "build": "npm run ci:build",
    "preview": "vitepress preview docs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "npm run ci:build",
    "docs:preview": "vitepress preview docs",
    "export:static": "node scripts/export-static.mjs",
    "content:index": "node scripts/content/sync-content-index.mjs",
    "audit:storage": "node scripts/maintenance/audit-storage.mjs",
    "clean:generated": "node scripts/maintenance/clean-generated.mjs",
    "test": "node --test scripts/tests/*.test.mjs",
    "verify:architecture": "node scripts/verification/verify-architecture.mjs",
    "verify:refactor": "node scripts/verification/verify-refactor-browser.mjs",
    "test:features": "node --test src/features/navigation/services/*.test.mjs src/features/study-progress/__tests__/*.test.js src/core/storage/__tests__/*.test.js src/features/study-tools/tests/*.test.mjs src/features/wiki/services/*.test.mjs src/features/lecture/services/lecture-model.test.mjs",
    "verify:math": "node --test scripts/tests/markdown-math-integrity.test.mjs scripts/tests/math-text.test.mjs scripts/tests/static-math-cache.test.mjs"
  },
  "keywords": [
    "uet",
    "study",
    "revision",
    "algorithms",
    "notes"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "debug": "^4.4.3",
    "markdown-it": "^15.0.2",
    "markdown-it-mathjax3": "^4.3.2",
    "mermaid": "^11.4.1",
    "puppeteer": "^25.12.0",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17"
  }
}
